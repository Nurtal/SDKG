      },
      "span_hash": {
         "@id": "span_hash"
      },
      "span_start": {
         "@type": "xsd:integer",
         "@id": "span_start"
      },
      "span_text": {
         "@id": "span_text"
      },
      "disease": {
         "@id": "disease"
      },
      "record_id": {
         "@id": "record_id"
      },
